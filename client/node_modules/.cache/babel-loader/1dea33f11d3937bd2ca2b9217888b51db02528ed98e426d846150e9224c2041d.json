{"ast":null,"code":"import{useEffect}from\"react\";import{useLocation}from\"react-router-dom\";const scrollPositions={};export default function ScrollRestoration(){const location=useLocation();useEffect(()=>{const path=location.pathname;if(scrollPositions[path]!==undefined){window.scrollTo(0,scrollPositions[path]);}else{window.scrollTo(0,0);}const handleScroll=()=>{scrollPositions[path]=window.scrollY;};window.addEventListener(\"scroll\",handleScroll);return()=>{scrollPositions[path]=window.scrollY;window.removeEventListener(\"scroll\",handleScroll);};},[location.pathname]);return null;}","map":{"version":3,"names":["useEffect","useLocation","scrollPositions","ScrollRestoration","location","path","pathname","undefined","window","scrollTo","handleScroll","scrollY","addEventListener","removeEventListener"],"sources":["C:/Users/rudym/Documents/proiecte/Cleaning/client/src/components/ScrollRestoration.jsx"],"sourcesContent":["import { useEffect } from \"react\";\r\nimport { useLocation } from \"react-router-dom\";\r\n\r\nconst scrollPositions = {};\r\n\r\nexport default function ScrollRestoration() {\r\n  const location = useLocation();\r\n\r\n  useEffect(() => {\r\n    const path = location.pathname;\r\n\r\n    if (scrollPositions[path] !== undefined) {\r\n      window.scrollTo(0, scrollPositions[path]);\r\n    } else {\r\n      window.scrollTo(0, 0);\r\n    }\r\n\r\n    const handleScroll = () => {\r\n      scrollPositions[path] = window.scrollY;\r\n    };\r\n\r\n    window.addEventListener(\"scroll\", handleScroll);\r\n\r\n    return () => {\r\n      scrollPositions[path] = window.scrollY;\r\n      window.removeEventListener(\"scroll\", handleScroll);\r\n    };\r\n  }, [location.pathname]);\r\n\r\n  return null;\r\n}"],"mappings":"AAAA,OAASA,SAAS,KAAQ,OAAO,CACjC,OAASC,WAAW,KAAQ,kBAAkB,CAE9C,KAAM,CAAAC,eAAe,CAAG,CAAC,CAAC,CAE1B,cAAe,SAAS,CAAAC,iBAAiBA,CAAA,CAAG,CAC1C,KAAM,CAAAC,QAAQ,CAAGH,WAAW,CAAC,CAAC,CAE9BD,SAAS,CAAC,IAAM,CACd,KAAM,CAAAK,IAAI,CAAGD,QAAQ,CAACE,QAAQ,